<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="gender">
    <xs:restriction base="xs:string">
      <xs:enumeration value="male"/>
      <xs:enumeration value="female"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="name">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="link">
    <xs:attribute name="ref" type="xs:IDREF" use="required"/>
  </xs:complexType>
  <xs:complexType name="parents">
    <xs:sequence>
      <xs:element name="father" type="link" minOccurs="0" maxOccurs="1"/>
      <xs:element name="mother" type="link" minOccurs="0" maxOccurs="1"/>
      <xs:element name="parent" type="link" minOccurs="0" maxOccurs="2"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="siblings">
    <xs:sequence>
      <xs:element name="brother" type="link" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="sister" type="link" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="sibling" type="link" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="children">
    <xs:sequence>
      <xs:element name="son" type="link" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="daughter" type="link" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="child" type="link" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="marriage">
    <xs:choice minOccurs="0">
      <xs:element name="husband" type="link"/>
      <xs:element name="wife" type="link"/>
      <xs:element name="spouse" type="link"/>
    </xs:choice>
  </xs:complexType>
  <xs:element name="people">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="person" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="first-name" type="name"/>
              <xs:element name="last-name" type="name"/>
              <xs:element name="gender" type="gender"/>
              <xs:element name="parents" type="parents"/>
              <xs:element name="marriage" type="marriage"/>
              <xs:element name="siblings" type="siblings"/>
              <xs:element name="children" type="children"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="children-count" type="xs:nonNegativeInteger" use="required"/>
            <xs:attribute name="siblings-count" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
